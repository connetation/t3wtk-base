{
    "name": "conn/sitepackage",
    "version": "1.0.0",
    "description": "Connetation Sitepackage for TYPO3 LTS 14 with Bootstrap 5, light/dark theme",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "require": {
        "typo3/cms-core": "^14.0",
        "typo3/cms-fluid": "^14.0",
        "typo3/cms-frontend": "^14.0",
        "typo3/cms-extbase": "^14.0",
        "typo3/cms-fluid-styled-content": "^14.0"
    },
    "autoload": {
        "psr-4": {
            "Connetation\\Sitepackage\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "conn_sitepackage"
        }
    }
}
