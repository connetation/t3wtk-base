{
    "name": "conn/t3kit-base",
    "version": "2.0.1",
    "description": "Connetation Base for TYPO3 LTS 14 with Bootstrap 5, light/dark theme",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "require": {
        "typo3/cms-core": "^14.0",
        "typo3/cms-fluid": "^14.0",
        "typo3/cms-frontend": "^14.0",
        "typo3/cms-extbase": "^14.0",
        "typo3/cms-fluid-styled-content": "^14.0"
    },
    "autoload": {
        "psr-4": {
            "Connetation\\T3kitBase\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "conn_t3kit_base"
        }
    }
}
