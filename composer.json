{
    "name": "connetation/t3wtk-base",
    "description": "Design system and foundation of the Connetation TYPO3 Web Toolkit (T3WTK) for TYPO3 14 LTS, themeable without writing code: page templates, navigation, footer, light/dark mode and 250+ site settings. Built on Site Sets and Bootstrap 5. Live demo: https://demosite.connetation.at",
    "keywords": ["TYPO3", "TYPO3 CMS", "extension", "t3wtk", "toolkit", "sitepackage", "theme", "design system", "content elements", "bootstrap", "site sets", "dark mode"],
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/connetation/t3wtk-base",
    "support": {
        "issues": "https://github.com/connetation/t3wtk-base/issues",
        "source": "https://github.com/connetation/t3wtk-base"
    },
    "authors": [
        {
            "name": "Connetation Web Engineering GmbH",
            "email": "office@connetation.at",
            "homepage": "https://www.connetation.at/"
        }
    ],
    "require": {
        "typo3/cms-core": "^14.0",
        "typo3/cms-fluid": "^14.0",
        "typo3/cms-frontend": "^14.0",
        "typo3/cms-extbase": "^14.0",
        "typo3/cms-fluid-styled-content": "^14.0"
    },
    "replace": {
        "conn/t3kit-base": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Connetation\\T3wtkBase\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "conn_t3wtk_base"
        }
    }
}
