plugin.tx_sfeventmgt.view {
    templateRootPaths.20 = EXT:conn_t3wtk_base/Resources/Private/Templates/Events/
    partialRootPaths.20  = EXT:conn_t3wtk_base/Resources/Private/Partials/Events/
    layoutRootPaths.20   = EXT:conn_t3wtk_base/Resources/Private/Layouts/Events/
}

# "Events – Seite 2" titles on paginated event list pages (page 1 keeps the plain title).
# Highest priority; the provider returns '' on every other page so the usual ones win.
config.pageTitleProviders.connEventPagination {
    provider = Connetation\T3wtkBase\PageTitle\EventPaginationPageTitleProvider
    before = news,csSeo,seo,record
}

@import 'EXT:conn_t3wtk_base/Configuration/TypoScript/Pagination/MetaDescription.typoscript'
