# ─────────────────────────────────────────────────────────────────────────────
# Content Element Backgrounds — Appearance tab (background color/image)
#
# Adds a higher-priority layoutRootPaths entry so every content element renders
# through conn_base's own ContentElements/Default.html instead of whichever
# extension's copy it would otherwise use.
#
# Two mechanisms are needed because of how TypoScript's `=<` copy operator works
# (it snapshots the source object's CURRENT state — later changes to the source
# don't retroactively reach anything already copied from it):
#
# 1. The standard fluid_styled_content CTypes are copied from lib.contentElement
#    at the very top of this extension's own setup.typoscript (the
#    `@import 'EXT:fluid_styled_content/...'` line), before this file runs — so
#    we patch each of those already-made copies directly.
# 2. Content-element extensions layered above conn_base (e.g. the optional
#    EXT:conn_elements library) copy `lib.contentElement` into their own base
#    object INSIDE their extension, which — since they depend on conn_base and
#    Sets load in dependency order — always runs after this whole file. For
#    those, simply updating lib.contentElement itself is enough: their later
#    `=<` copy picks up this layoutRootPaths entry automatically.
# ─────────────────────────────────────────────────────────────────────────────

lib.contentElement.layoutRootPaths.30  = EXT:conn_base/Resources/Private/Layouts/ContentElements/
lib.contentElement.partialRootPaths.30 = EXT:conn_base/Resources/Private/Partials/

tt_content.text.layoutRootPaths.30      = EXT:conn_base/Resources/Private/Layouts/ContentElements/
tt_content.textpic.layoutRootPaths.30   = EXT:conn_base/Resources/Private/Layouts/ContentElements/
tt_content.textmedia.layoutRootPaths.30 = EXT:conn_base/Resources/Private/Layouts/ContentElements/
tt_content.image.layoutRootPaths.30     = EXT:conn_base/Resources/Private/Layouts/ContentElements/
tt_content.header.layoutRootPaths.30    = EXT:conn_base/Resources/Private/Layouts/ContentElements/
tt_content.html.layoutRootPaths.30      = EXT:conn_base/Resources/Private/Layouts/ContentElements/
tt_content.bullets.layoutRootPaths.30   = EXT:conn_base/Resources/Private/Layouts/ContentElements/
tt_content.table.layoutRootPaths.30     = EXT:conn_base/Resources/Private/Layouts/ContentElements/
tt_content.uploads.layoutRootPaths.30   = EXT:conn_base/Resources/Private/Layouts/ContentElements/
tt_content.shortcut.layoutRootPaths.30  = EXT:conn_base/Resources/Private/Layouts/ContentElements/
tt_content.div.layoutRootPaths.30       = EXT:conn_base/Resources/Private/Layouts/ContentElements/

tt_content.text.partialRootPaths.30      = EXT:conn_base/Resources/Private/Partials/
tt_content.textpic.partialRootPaths.30   = EXT:conn_base/Resources/Private/Partials/
tt_content.textmedia.partialRootPaths.30 = EXT:conn_base/Resources/Private/Partials/
tt_content.image.partialRootPaths.30     = EXT:conn_base/Resources/Private/Partials/
tt_content.header.partialRootPaths.30    = EXT:conn_base/Resources/Private/Partials/
tt_content.html.partialRootPaths.30      = EXT:conn_base/Resources/Private/Partials/
tt_content.bullets.partialRootPaths.30   = EXT:conn_base/Resources/Private/Partials/
tt_content.table.partialRootPaths.30     = EXT:conn_base/Resources/Private/Partials/
tt_content.uploads.partialRootPaths.30   = EXT:conn_base/Resources/Private/Partials/
tt_content.shortcut.partialRootPaths.30  = EXT:conn_base/Resources/Private/Partials/
tt_content.div.partialRootPaths.30       = EXT:conn_base/Resources/Private/Partials/
