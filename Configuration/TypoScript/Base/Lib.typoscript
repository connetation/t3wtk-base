# ─────────────────────────────────────────────
# Content Element lib base object
# Extends fluid_styled_content's lib.contentElement
# by adding conn_base paths at index 10.
# Uses property assignment (no =) to preserve
# fluid_styled_content's dataProcessing and settings.
# Elements add their own paths at index 20.
# ─────────────────────────────────────────────

lib.contentElement {
    templateRootPaths {
        10 = EXT:conn_base/Resources/Private/Templates/ContentElements/
    }
    partialRootPaths {
        10 = EXT:conn_base/Resources/Private/Partials/
    }
    settings {
        defaultHeaderType = 2
        media {
            popup {
                directImageLink = 1
                JSwindow = 0
                width =
                height =
                crop >
                linkParams.ATagParams.dataWrap = class="glightbox" data-title="{file:current:title}" data-description="{file:current:description}"
            }
        }
    }
}
