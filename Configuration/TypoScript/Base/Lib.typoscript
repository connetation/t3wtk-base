# ─────────────────────────────────────────────
# Content Element lib base object
# Extends fluid_styled_content's lib.contentElement
# by adding conn_base paths at index 10.
# Uses property assignment (no =) to preserve
# fluid_styled_content's dataProcessing and settings.
# Elements add their own paths at index 20.
# ─────────────────────────────────────────────

lib.contentElement {
    templateRootPaths {
        10 = EXT:conn_base/Resources/Private/Templates/ContentElements/
    }
    partialRootPaths {
        10 = EXT:conn_base/Resources/Private/Partials/
    }
    settings {
        # Resolves from the site setting styles.content.defaultHeaderType
        # (fsc already maps this — re-declared here only for clarity).
        defaultHeaderType = {$styles.content.defaultHeaderType}

        # Gallery spacing/border site settings for the conn_base Media/Gallery
        # partial. {site.settings.*} is NOT available in the content element
        # Fluid context (only in the page template), so they must travel via
        # the TypoScript settings mapping like defaultHeaderType above.
        gallery {
            columnSpacing = {$styles.content.textmedia.columnSpacing}
            rowSpacing = {$styles.content.textmedia.rowSpacing}
            borderWidth = {$styles.content.textmedia.borderWidth}
            borderColor = {$styles.content.textmedia.borderColor}
            borderPadding = {$styles.content.textmedia.borderPadding}
        }
        media {
            popup {
                directImageLink = 1
                JSwindow = 0
                width =
                height =
                crop >
                linkParams.ATagParams.dataWrap = class="glightbox" data-title="{file:current:title}" data-description="{file:current:description}"
            }
        }
    }
}
