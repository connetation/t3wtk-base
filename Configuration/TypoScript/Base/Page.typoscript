# ─────────────────────────────────────────────
# Page Object
# ─────────────────────────────────────────────

# TYPO3's PageRenderer owns the document shell (<!DOCTYPE>, <html>, <head>,
# <body>) — the Fluid layout renders body content only.
config {
    htmlTag.attributes.data-bs-theme = light
    htmlTag.attributes.class = h-100
}

# Content in the "Top Content" column (colPos 1) of the conn_topcontent
# backend layout — styles.content.get (core default) only selects colPos 0.
lib.contentTop = CONTENT
lib.contentTop {
    table = tt_content
    select {
        orderBy = sorting
        where = {#colPos}=1
    }
}

page = PAGE
page {
    typeNum = 0

    # Sticky-footer flexbox classes, plus optional feature classes appended
    # only when their site setting is active.
    bodyTagCObject = COA
    bodyTagCObject {
        5 = TEXT
        5.value = <body id="page-

        7 = TEXT
        7.data = page:uid

        9 = TEXT
        9.value = " class="d-flex flex-column min-vh-100

        15 = TEXT
        15.char = 32

        20 = TEXT
        20.value = has-float-toggle
        20.if.isTrue = {$themeToggle.position}

        25 = TEXT
        25.char = 32

        30 = TEXT
        30.value = link-hover-underline
        30.if.isTrue = {$theme.linkHoverEffect}

        40 = TEXT
        40.value = ">
    }

    meta {
        viewport = width=device-width, initial-scale=1
        color-scheme = light dark
        robots = index, follow
        google-site-verification = {$meta.googleVerification}
    }

    includeCSS {
        bootstrap = EXT:conn_t3kit_base/Resources/Public/Css/main.css
        bootstrap.media = all
    }

    includeJSFooter {
        app = EXT:conn_t3kit_base/Resources/Public/Js/main.js
        app.defer = 1
    }

    10 = FLUIDTEMPLATE
    10 {
        templateName = TEXT
        templateName.stdWrap.cObject = CASE
        templateName.stdWrap.cObject {
            key.data = levelfield:-1, backend_layout_next_level, slide
            key.override.field = backend_layout

            pagets__conn_default = TEXT
            pagets__conn_default.value = Default

            pagets__conn_topcontent = TEXT
            pagets__conn_topcontent.value = TopContent

            default = TEXT
            default.value = Default
        }

        templateRootPaths {
            0 = EXT:conn_t3kit_base/Resources/Private/Templates/Page/
        }
        partialRootPaths {
            0 = EXT:conn_t3kit_base/Resources/Private/Partials/
        }
        layoutRootPaths {
            0 = EXT:conn_t3kit_base/Resources/Private/Layouts/
        }

        dataProcessing {
            10 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            10 {
                levels = 4
                expandAll = 1
                includeSpacer = 1
                as = mainNavigation
            }

            20 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            20 {
                special = rootline
                as = breadcrumb
            }

            30 = TYPO3\CMS\Frontend\DataProcessing\SiteProcessor
            30 {
                as = site
            }

            40 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            40 {
                levels = 1
                expandAll = 1
                includeSpacer = 0
                as = footerNavigation
                includeNotInMenu = {$footer.navigation.includeNotInMenu}
            }

            # Separate, independently curated menu for the footer bottom-bar
            # "Navigation (inline)" slot (e.g. Impressum, AGB, FAQ) — kept
            # apart from footerNavigation above so the bar doesn't just repeat
            # the full footer menu.
            50 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            50 {
                levels = 1
                expandAll = 1
                includeSpacer = 0
                as = footerBarNavigation
                includeNotInMenu = {$footer.barNavigation.includeNotInMenu}
            }

            60 = Connetation\T3kitBase\DataProcessing\ThemeVarsProcessor
            60 {
                as = themeVars
            }
        }
    }
}

["{$footer.navigation.type}" == "list"]
page.10.dataProcessing.40 {
    special = list
    special.value = {$footer.navigation.pages}
    levels = 1
}
[global]

["{$footer.navigation.type}" == "directory"]
page.10.dataProcessing.40 {
    special = directory
    special.value = {$footer.navigation.pages}
}
[global]

["{$footer.barNavigation.type}" == "list"]
page.10.dataProcessing.50 {
    special = list
    special.value = {$footer.barNavigation.pages}
    levels = 1
}
[global]

["{$footer.barNavigation.type}" == "directory"]
page.10.dataProcessing.50 {
    special = directory
    special.value = {$footer.barNavigation.pages}
}
[global]

# Apply the stored theme in <head>, before <body> is styled — otherwise the
# body paints light first and fades to dark via the global theme transition.
# conn-theme-preload suppresses transitions until main.js removes it.
page.headerData.5 = TEXT
page.headerData.5.value = <script>(function(){var d=document.documentElement,t=null;try{t=localStorage.getItem('conn-theme')}catch(e){}if(t)d.setAttribute('data-bs-theme',t);d.classList.add('conn-theme-preload')})();</script>

# theme-color per scheme, only when the corresponding site setting is set
["{$theme.light.bg}" != ""]
page.headerData.20 = TEXT
page.headerData.20.value = <meta name="theme-color" content="{$theme.light.bg}" media="(prefers-color-scheme: light)">
[global]

["{$theme.dark.bg}" != ""]
page.headerData.21 = TEXT
page.headerData.21.value = <meta name="theme-color" content="{$theme.dark.bg}" media="(prefers-color-scheme: dark)">
[global]

# Favicon / apple-touch-icon / manifest links from the branding.* site settings.
# Renders nothing when none are set. The matching root URLs (/favicon.ico,
# /apple-touch-icon.png, /site.webmanifest) are answered by BrandingIconsMiddleware.
page.headerData.25 = FLUIDTEMPLATE
page.headerData.25 {
    file = EXT:conn_t3kit_base/Resources/Private/Templates/Page/Head/Favicon.html
    dataProcessing.10 = Connetation\T3kitBase\DataProcessing\BrandingIconsProcessor
    dataProcessing.10.as = brandingIcons
}
