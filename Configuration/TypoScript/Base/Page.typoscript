# ─────────────────────────────────────────────
# Page Object
# ─────────────────────────────────────────────

# TYPO3's PageRenderer owns the document shell (<!DOCTYPE>, <html>, <head>,
# <body>) — the Fluid layout renders body content only.
config {
    htmlTag.attributes.data-bs-theme = auto
    htmlTag.attributes.class = h-100
}

page = PAGE
page {
    typeNum = 0

    # Sticky-footer flexbox classes (extended below via condition when the
    # floating theme toggle is enabled).
    bodyTagCObject = TEXT
    bodyTagCObject.value = <body class="d-flex flex-column h-100">

    meta {
        viewport = width=device-width, initial-scale=1
        color-scheme = light dark
        robots = index, follow
        google-site-verification = {$meta.googleVerification}
    }

    includeCSS {
        bootstrap = EXT:conn_base/Resources/Public/Css/main.css
        bootstrap.media = all
    }

    includeJSFooter {
        app = EXT:conn_base/Resources/Public/Js/main.js
        app.defer = 1
    }

    10 = FLUIDTEMPLATE
    10 {
        templateName = TEXT
        templateName.stdWrap.cObject = CASE
        templateName.stdWrap.cObject {
            key.data = levelfield:-1, backend_layout_next_level, slide
            key.override.field = backend_layout

            pagets__conn_default = TEXT
            pagets__conn_default.value = Default

            pagets__conn_landingpage = TEXT
            pagets__conn_landingpage.value = LandingPage

            default = TEXT
            default.value = Default
        }

        templateRootPaths {
            0 = EXT:conn_base/Resources/Private/Templates/Page/
        }
        partialRootPaths {
            0 = EXT:conn_base/Resources/Private/Partials/
        }
        layoutRootPaths {
            0 = EXT:conn_base/Resources/Private/Layouts/
        }

        dataProcessing {
            10 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            10 {
                levels = 4
                expandAll = 1
                includeSpacer = 1
                as = mainNavigation
            }

            20 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            20 {
                special = rootline
                as = breadcrumb
            }

            30 = TYPO3\CMS\Frontend\DataProcessing\SiteProcessor
            30 {
                as = site
            }

            40 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            40 {
                levels = 1
                expandAll = 1
                includeSpacer = 0
                as = footerNavigation
                includeNotInMenu = {$footer.navigation.includeNotInMenu}
            }
        }
    }
}

["{$footer.navigation.type}" == "list"]
page.10.dataProcessing.40 {
    special = list
    special.value = {$footer.navigation.pages}
    levels = 1
}
[global]

["{$footer.navigation.type}" == "directory"]
page.10.dataProcessing.40 {
    special = directory
    special.value = {$footer.navigation.pages}
}
[global]

# Body class variant when the floating theme toggle is enabled
["{$themeToggle.position}" != ""]
page.bodyTagCObject.value = <body class="d-flex flex-column h-100 has-float-toggle">
[global]

# theme-color per scheme, only when the corresponding site setting is set
["{$theme.light.bg}" != ""]
page.headerData.20 = TEXT
page.headerData.20.value = <meta name="theme-color" content="{$theme.light.bg}" media="(prefers-color-scheme: light)">
[global]

["{$theme.dark.bg}" != ""]
page.headerData.21 = TEXT
page.headerData.21.value = <meta name="theme-color" content="{$theme.dark.bg}" media="(prefers-color-scheme: dark)">
[global]
